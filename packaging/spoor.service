[Unit]
Description=spoor file index daemon
After=local-fs.target
# The snapshot is served as soon as it loads, while a reconciliation walk runs
# behind it; nothing else needs ordering.

[Service]
Type=simple
ExecStart=/usr/local/bin/spoor daemon \
    --config /etc/spoor/spoor.conf \
    --socket /run/spoor.sock \
    --state /var/lib/spoor/index.bin \
    --save-interval 60 \
    $SPOOR_EXTRA_ARGS
# Which folders to index, exclude and rescan lives in /etc/spoor/spoor.conf,
# edited from the window's Preferences (through `spoor configure`); with no
# file, /home is indexed. Extra flags can go in a drop-in as SPOOR_EXTRA_ARGS.
# A rescanned FUSE mount must admit root: rclone ignores --allow-root, so mount
# with --allow-other --default-permissions --umask 077 (see README).

# Runs as root: FAN_MARK_FILESYSTEM, FAN_UNLIMITED_QUEUE and
# FAN_UNLIMITED_MARKS all require CAP_SYS_ADMIN; the DAC capabilities let the
# walk and open_by_handle_at reach every directory.
# CAP_SETUID and CAP_SETGID let a query thread take on the caller's filesystem
# identity, so results are filtered by what that user may list (see ipc.rs).
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_SETUID CAP_SETGID
NoNewPrivileges=yes

# systemd creates and owns /var/lib/spoor for the snapshot.
StateDirectory=spoor
# The snapshot holds every indexed file name: root only.
StateDirectoryMode=0700
UMask=0077

# Read-only everywhere except the snapshot and the socket.
ProtectSystem=strict
ReadWritePaths=/run /var/lib/spoor
# MUST stay 'no': indexing /home is the entire point, and ProtectHome would
# hide it from the daemon.
ProtectHome=no
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# Nothing below is used by a fanotify daemon, so it all goes.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

Restart=on-failure
RestartSec=5

# The daemon reacts to SIGTERM by writing a final snapshot before exiting.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
